# Application
APP_ENV=development
APP_NAME=MailMind AI

# Ports
WEB_PORT=3000
API_PORT=8000

# Database (Docker Compose default)
DATABASE_URL=postgresql+psycopg://mailmind:mailmind_dev_password@db:5432/mailmind

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=replace_me_with_a_very_long_random_secret_key_at_least_64_characters_long

# Google OAuth (Gmail Integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/accounts/gmail/callback

# AI Providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MailMind AI
